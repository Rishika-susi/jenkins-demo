pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Building Application'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing Application'
            }
        }

        stage('Docker Check') {
            steps {
                sh 'docker --version'
            }
        } 

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t myfirstimage:v1 .'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying Application'
            }
        }

    }
}
